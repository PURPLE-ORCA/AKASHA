{
  "name": "akasha",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "extension",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run --filter '*' check",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:extension": "bun run --cwd extension dev",
    "e2e": "bun run --cwd apps/web e2e",
    "lint": "bun run --cwd apps/web lint && biome check extension packages/contracts",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1"
  }
}
